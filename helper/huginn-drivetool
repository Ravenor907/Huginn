#!/usr/bin/env python3
"""Huginn's drive helper. Huginn opens the USB drive through udisks and hands this helper the
open file descriptor; the helper does the byte-level work with Handheld Forge's own modules
(github.com/Ravenor907/Handheld-Forge), so both apps share one tested Ventoy installer.

Every message to Huginn is one JSON object per line on stdout:
  {"stage": "write", "done": 10, "total": 100}
  {"log": "text"}
  {"result": {...}}            last line on success
  {"error": "text"}            last line on failure
"""

from __future__ import annotations

import argparse
import hashlib
import secrets
import struct
import json
import lzma
import os
import signal
import sys
import threading
from pathlib import Path

FORGE = os.environ.get("HUGINN_FORGE_PATH", "/app/lib/huginn/forge")
sys.path.insert(0, FORGE)

from handheld_forge import ventoy  # noqa: E402
from handheld_forge.blockdev import FdDisk, cancelled  # noqa: E402
from handheld_forge.rawwrite import Cancelled, RawWriteError, write_image  # noqa: E402

CANCEL = threading.Event()


def emit(**msg) -> None:
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def stage(name, done=0, total=0) -> None:
    emit(stage=name, done=int(done), total=int(total))


def log(text) -> None:
    emit(log=str(text))


def inspect(dev) -> dict:
    found = ventoy.detect(dev)
    if not found:
        return {"ventoy": False}
    _, efi = found
    part2 = ventoy.read_efi(dev, efi)
    return {
        "ventoy": True,
        "version": ventoy.version_of(part2) or "",
        "secureBoot": ventoy.secure_boot_enabled(part2),
        "gpt": dev.read(0, 1)[450] == 0xEE,
    }


def update(dev, files: ventoy.Files) -> None:
    """Ventoy2Disk.sh -u for MBR drives: new boot code and EFI partition, images untouched."""
    found = ventoy.detect(dev)
    if not found:
        raise RawWriteError("This drive doesn't have Ventoy on it, so there's nothing to update.")
    _, efi = found
    s0 = bytearray(dev.read(0, 1))
    if s0[450] == 0xEE:
        raise RawWriteError("This drive uses Ventoy's GPT layout. Install Ventoy again to update it.")
    secure = ventoy.secure_boot_enabled(ventoy.read_efi(dev, efi))
    core = lzma.decompress(files.core_img_xz)
    if len(core) > 2047 * 512:
        raise RawWriteError("This Ventoy release's boot code is larger than expected.")
    part2 = bytearray(lzma.decompress(files.disk_img_xz))
    if len(part2) != ventoy.PART2_SECTORS * 512 or efi.sectors * 512 != len(part2):
        raise RawWriteError("This Ventoy release's EFI partition doesn't fit this drive's layout.")
    if not secure:
        ventoy.disable_secure_boot(part2)
    log("Secure Boot support stays " + ("on" if secure else "off"))

    uuid = bytes(s0[384:400])
    s0[0:440] = files.boot_img[:440]
    s0[384:400] = uuid
    if s0[446] == 0x00 and s0[462] == 0x80:
        s0[446], s0[462] = 0x80, 0x00
    reserved = dev.read(2040, 8)
    core_sectors = bytearray(core.ljust(2047 * 512, b"\0"))
    core_sectors[2039 * 512 : 2047 * 512] = reserved

    plan = [(efi.start, bytes(part2)), (1, bytes(core_sectors)), (0, bytes(s0))]
    total = sum(len(d) for _, d in plan) // 512
    done = 0
    for lba, data in plan:
        for at in range(0, len(data), 2048 * 512):
            if cancelled(CANCEL):
                raise Cancelled()
            piece = data[at : at + 2048 * 512]
            dev.write(lba + at // 512, piece)
            done += len(piece) // 512
            stage("write", done, total)
    dev.sync()

    log("Reading Ventoy back from the drive to confirm")
    checked = 0
    for lba, data in plan:
        back = dev.read(lba, len(data) // 512)
        if hashlib.sha256(back).digest() != hashlib.sha256(data).digest():
            raise RawWriteError("The drive didn't keep what was written. It may be failing; try another drive.")
        checked += len(data) // 512
        stage("check", checked, total)
    log("Ventoy is updated. Your images were not touched.")


# ------------------------------------------------------------------ FAT32 (for Windows installers)

FAT32_LIMIT = 4 * 1024**3 - 1  # the largest file FAT32 can hold


def fat32_cluster_sectors(sectors: int) -> int:
    """Cluster size by volume size, the same steps Windows' format uses."""
    size = sectors * 512
    for limit, spc in ((8 * 1024**3, 8), (16 * 1024**3, 16), (32 * 1024**3, 32)):
        if size <= limit:
            return spc
    return 64


def fat32_format(dev, start: int, sectors: int, label: str, progress=lambda d, t: None) -> None:
    """Write an empty FAT32 file system into `sectors` sectors starting at `start` (512-byte sectors)."""
    spc = fat32_cluster_sectors(sectors)
    reserved, fats = 32, 2
    # Microsoft's FAT32 sizing formula (fatgen103): enough FAT for every cluster that fits.
    tmp1 = sectors - reserved
    tmp2 = (256 * spc + fats) // 2
    fat_sectors = (tmp1 + tmp2 - 1) // tmp2
    clusters = (sectors - reserved - fats * fat_sectors) // spc
    if clusters < 65525:
        raise RawWriteError("This partition is too small for FAT32.")
    label11 = (label.upper().encode("ascii", "replace")[:11]).ljust(11, b" ")
    serial = secrets.randbits(32)

    boot = bytearray(512)
    boot[0:3] = b"\xEB\x58\x90"
    boot[3:11] = b"MSWIN4.1"
    struct.pack_into("<HBHBHHBHHHII", boot, 11, 512, spc, reserved, fats, 0, 0, 0xF8, 0, 63, 255, start, sectors)
    struct.pack_into("<IHHIHH", boot, 36, fat_sectors, 0, 0, 2, 1, 6)
    boot[64] = 0x80        # drive number
    boot[66] = 0x29        # extended boot signature
    struct.pack_into("<I", boot, 67, serial)
    boot[71:82] = label11
    boot[82:90] = b"FAT32   "
    boot[510:512] = b"\x55\xAA"

    info = bytearray(512)
    struct.pack_into("<I", info, 0, 0x41615252)
    struct.pack_into("<III", info, 484, 0x61417272, clusters - 1, 3)
    struct.pack_into("<I", info, 508, 0xAA550000)

    # Reserved area: boot sector, FSInfo, sector 2 signature, backups at 6 and 7.
    area = bytearray(reserved * 512)
    area[0:512] = boot
    area[512:1024] = info
    area[2 * 512 + 510 : 2 * 512 + 512] = b"\x55\xAA"
    area[6 * 512 : 7 * 512] = boot
    area[7 * 512 : 8 * 512] = info
    dev.write(start, bytes(area))

    total = fats * fat_sectors + spc
    done = 0
    zeros = bytes(2048 * 512)
    first = bytearray(512)
    struct.pack_into("<III", first, 0, 0x0FFFFFF8, 0x0FFFFFFF, 0x0FFFFFFF)  # media, reserved, root dir end
    for n in range(fats):
        base = start + reserved + n * fat_sectors
        dev.write(base, bytes(first))
        at = 1
        while at < fat_sectors:
            if cancelled(CANCEL):
                raise Cancelled()
            count = min(2048, fat_sectors - at)
            dev.write(base + at, zeros[: count * 512])
            at += count
            done += count
            progress(done, total)
    root = bytearray(spc * 512)
    root[0:11] = label11
    root[11] = 0x08        # volume label entry
    dev.write(start + reserved + fats * fat_sectors, bytes(root))
    progress(total, total)


def windows_layout(dev, boot_mb: int) -> dict:
    """Rufus-style Windows installer layout on an MBR drive. boot_mb 0: one FAT32 partition for
    everything. Otherwise a FAT32 boot partition of boot_mb plus an exFAT partition for the files
    FAT32 can't hold (install.wim over 4 GB); Windows Setup looks for its image on both."""
    from handheld_forge import exfat

    if dev.block_size != 512:
        raise RawWriteError(f"This drive uses {dev.block_size}-byte sectors, which Huginn can't lay out for Windows yet.")
    start = 2048
    usable = (dev.block_count - start) // 2048 * 2048
    log("Clearing the old layout")
    exfat.wipe_ends(dev)
    stage("write", 0, 0)
    if boot_mb <= 0:
        p1 = usable
        parts = [(start, p1, 0x0C, True)]
    else:
        p1 = boot_mb * 2048
        if p1 + 8 * 2048 * 1024 > usable:
            raise RawWriteError("This drive is too small for this Windows version. Use a bigger one (16 GB or more).")
        p2_start = start + p1
        p2 = usable - p1
        parts = [(start, p1, 0x0C, True), (p2_start, p2, 0x07, False)]
    log(f"Formatting FAT32, {p1 * 512 / 1e9:.1f} GB, label WINSETUP")
    fat32_format(dev, start, p1, "WINSETUP", progress=lambda d, t: stage("write", d, t))
    if len(parts) > 1:
        log(f"Formatting exFAT, {parts[1][1] * 512 / 1e9:.1f} GB, label WININSTALL")
        exfat.format_volume(dev, parts[1][0], parts[1][1], "WININSTALL", progress=lambda d, t: stage("write", d, t))
    mbr = bytearray(512)
    exfat.write_mbr_table(mbr, parts)
    mbr[440:444] = secrets.token_bytes(4)
    dev.write(0, bytes(mbr))
    dev.sync()
    stage("check", 0, 1)
    if dev.read(0, 1) != bytes(mbr):
        raise RawWriteError("The drive didn't keep what was written. It may be failing; try another drive.")
    stage("check", 1, 1)
    return {"partitions": len(parts)}


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("command", choices=["inspect", "ventoy-install", "ventoy-update", "write-image", "format", "steamos", "windows-layout"])
    p.add_argument("--fd", type=int, required=True)
    p.add_argument("--name", default="drive")
    p.add_argument("--cache", default=str(Path.home() / ".cache" / "huginn" / "ventoy"))
    p.add_argument("--secure-boot", default="1")
    p.add_argument("--image", default="")
    p.add_argument("--boot-mb", type=int, default=0)
    a = p.parse_args()

    signal.signal(signal.SIGTERM, lambda *_: CANCEL.set())
    dev = FdDisk(a.fd, a.name)
    try:
        if a.command == "inspect":
            emit(result=inspect(dev))
        elif a.command in ("ventoy-install", "ventoy-update"):
            rel, files = ventoy.fetch_latest(Path(a.cache), stage=stage, log=log, cancel=CANCEL)
            if a.command == "ventoy-install":
                ventoy.install(dev, files, stage=stage, log=log, cancel=CANCEL, secure_boot=a.secure_boot == "1")
            else:
                update(dev, files)
            emit(result={"version": rel.version})
        elif a.command == "format":
            # Used when the system's own exFAT tools aren't installed.
            from handheld_forge import exfat

            exfat.plain_format(dev, "USB", stage=stage, log=log, cancel=CANCEL)
            emit(result={})
        elif a.command == "windows-layout":
            emit(result=windows_layout(dev, a.boot_mb))
        elif a.command == "steamos":
            # Valve's recovery image, downloaded (resumable, cached) and written like Handheld Forge does.
            from handheld_forge import config, download
            from handheld_forge.imagekind import ImageKind

            distro = config.get_distro("steamos")
            need = distro.min_drive_gb * 1000**3 * 0.9
            if os.lseek(a.fd, 0, os.SEEK_END) < need:
                raise RawWriteError(f"SteamOS needs a drive of at least {distro.min_drive_gb} GB.")
            img = download.prepare_iso(distro, stage=stage, log=log, cancel=CANCEL)
            n = write_image(a.fd, str(img.path), compressed=ImageKind.BZIP2, stage=stage, log=log, cancel=CANCEL)
            emit(result={"bytes": n})
        else:
            from handheld_forge.imagekind import ImageKind

            name = a.image.lower()
            kind = False
            for suffix, k in ((".bz2", "BZIP2"), (".xz", "XZ"), (".gz", "GZIP"), (".zip", "ZIP")):
                if name.endswith(suffix) and hasattr(ImageKind, k):
                    kind = getattr(ImageKind, k)
            n = write_image(a.fd, a.image, compressed=kind, stage=stage, log=log, cancel=CANCEL)
            emit(result={"bytes": n})
    except Cancelled:
        emit(error="Stopped. The drive may need to be written again before it boots.")
        return 2
    except Exception as e:  # anything else still has to reach Huginn as a plain message
        if type(e).__name__ == "Cancelled":
            emit(error="Stopped. The drive may need to be written again before it boots.")
            return 2
        if not isinstance(e, (RawWriteError, OSError)):
            emit(error=f"{type(e).__name__}: {e}")
            return 1
        emit(error=str(e))
        return 1
    finally:
        dev.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
